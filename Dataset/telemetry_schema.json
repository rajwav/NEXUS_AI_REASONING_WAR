{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "NEXUS Player Cognitive Telemetry Schema",
  "type": "object",
  "properties": {
    "session_id": { "type": "string" },
    "player_name": { "type": "string" },
    "velocity": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
    "error_rate": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
    "hint_dependency": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
    "risk_index": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
    "autonomy_ratio": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
    "classified_archetype": {
      "type": "string",
      "enum": ["EXPLORER", "STRATEGIST", "HACKER", "BEGINNER"]
    },
    "dynamic_difficulty": {
      "type": "string",
      "enum": ["EASY", "NORMAL", "HARD", "EXPERT"]
    },
    "predicted_success_prob": { "type": "number", "minimum": 0.0, "maximum": 1.0 }
  },
  "required": [
    "session_id",
    "velocity",
    "error_rate",
    "hint_dependency",
    "risk_index",
    "autonomy_ratio"
  ]
}
